# Biomed MCP Server Configuration
# Copy this file to .env and fill in your values. All values are optional —
# Monarch, HPO, Orphanet, MedlinePlus, Europe PMC, and ClinicalTrials need no credentials.

# NCBI API Key (optional but recommended)
# Get your API key at: https://www.ncbi.nlm.nih.gov/account/settings/
# Provides higher rate limits (10 requests/second vs 3 requests/second), shared across
# all NCBI databases (PubMed, ClinVar, Gene, MeSH, ...).
NCBI_API_KEY=your_api_key_here

# Email address (optional but recommended)
# NCBI requests this for API usage tracking and to contact you if needed
NCBI_EMAIL=your_email@example.com

# OMIM API Key (optional; ACADEMIC use only)
# Activates OMIM enrichment in get_disease_info. Request a free academic key at:
# https://www.omim.org/api  — NOTE: OMIM is not redistributable for commercial use without a paid license.
# OMIM_API_KEY=your_omim_api_key_here